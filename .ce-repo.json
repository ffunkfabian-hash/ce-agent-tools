{
  "name": "ce-agent-tools",
  "version": {
    "file": "plugins/ce-shared/.claude-plugin/plugin.json",
    "pattern": "\"version\"\\s*:\\s*\"([^\"]+)\""
  },
  "check": {
    "quick": [
      "python3",
      "-m",
      "unittest",
      "discover",
      "-s",
      "tests",
      "-q"
    ]
  },
  "docs": {
    "changelog": "CHANGELOG.md",
    "lessons": "README.md#erfahrungen",
    "versions": "docs/versions"
  },
  "core_paths": [
    "plugins/ce-shared/contracts/*.json",
    "plugins/ce-shared/hooks/guard.py",
    "plugins/ce-shared/rules/*.md",
    "plugins/ce-shared/hooks/hooks.json",
    "plugins/ce-shared/githooks/ce_githooks.py",
    "plugins/ce-shared/tools/ce_common.py",
    "plugins/ce-shared/tools/ce_contract.py",
    "plugins/ce-shared/tools/ce_loader.py",
    "plugins/ce-shared/tools/ce_merge_check.py",
    "plugins/ce-shared/hooks/codex_guard.py",
    "plugins/ce-shared/hooks/vibe_guard.py",
    "plugins/ce-shared/hooks/antigravity_guard.py",
    "plugins/ce-shared/agents/*.md",
    ".github/workflows/*",
    ".ce-repo.json"
  ],
  "heavy_lock": false,
  "coordination": {
    "repo": "ffunkfabian-hash/cubeescape-nexogen",
    "registry": "https://github.com/ffunkfabian-hash/cubeescape-nexogen/blob/main/repos.json"
  },
  "lint": {
    "profile": "rules"
  }
}
