#!/bin/sh
# ce - one entry for the shared tools of a repo (0.5.0): ./ce <command> [args]
#   check [--full|--nightly]   session reserve|patch|topics|mail|say|who   codex quota|cloud|judge
#   evidence clip|sheet|still|diff   search query|index|status   lock <resource>|status   docs   report   api login|status|budget|ask
#   plugins check|fix [--apply] [--user-only]   (0.16: Claude-Code-Installationen von ce-shared auf einer Version)
#   tidy [--apply|--nightly] [--json] [--category K]   (0.18: Reste fertiger Sitzungen, Probelauf ohne --apply)
here="$(cd "$(dirname "$0")" && pwd)"; tools="$here"
[ -f "$tools/ce_check.py" ] || tools="$here/ce_tools"
cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  session)
    sub="${1:-help}"; [ $# -gt 0 ] && shift
    case "$sub" in
      reserve) [ "${1:-}" = --name ] && shift; exec python3 "$tools/ce_session_name.py" --name "$@" --reserve;;
      topics) exec python3 "$tools/ce_session_name.py" --task Blick --topics "$@";;
      patch) exec python3 "$tools/ce_session_name.py" --reserve --patch "$@";;
      mail) exec python3 "$tools/ce_await_mail.py" "$@";;
      say|who) exec python3 "$tools/ce_postfach.py" "$sub" "$@";;
      *) echo "session reserve <Name> | patch <kurzname> | topics | mail [--name <Name>] | say [--to <Empfänger>] <Thema> [Zeilen] | who"; exit 2;;
    esac;;
  codex)
    sub="${1:-help}"; [ $# -gt 0 ] && shift
    case "$sub" in
      quota|cloud) exec python3 "$tools/ce_codex_${sub}.py" "$@";;
      judge) exec python3 "$tools/ce_judge.py" "$@";;
      *) echo "codex quota | cloud | judge"; exit 2;;
    esac;;
  evidence)
    sub="${1:-help}"; [ $# -gt 0 ] && shift
    case "$sub" in
      preflight) exec python3 "$tools/ce_blender_preflight.py" "$@";;
      turnaround) exec python3 "$tools/ce_turnaround.py" "$@";;
      diff) exec python3 "$tools/ce_imagediff.py" "$@";;
      clip|sheet|still) exec python3 "$tools/ce_media.py" "$sub" "$@";;
      *) echo "evidence clip | sheet | still | diff"; exit 2;;
    esac;;
  check)    mode=quick; case "${1:-}" in --full) mode=full; shift;; --nightly) mode=nightly; shift;; esac; exec python3 "$tools/ce_check.py" "$mode" "$@";;
  reserve)  [ "${1:-}" = --name ] && shift; exec python3 "$tools/ce_session_name.py" --name "$@" --reserve;;
  topics)   exec python3 "$tools/ce_session_name.py" --task Blick --topics;;
  search)
    case "${1:-}" in query|index|status|serve) exec python3 "$tools/ce_search.py" "$@";; esac
    exec python3 "$tools/ce_search.py" query "$@";;
  index)    exec python3 "$tools/ce_search.py" index "$@";;
  judge)    exec python3 "$tools/ce_judge.py" "$@";;
  diff)     exec python3 "$tools/ce_imagediff.py" "$@";;
  sheet|clip|still) exec python3 "$tools/ce_media.py" "$cmd" "$@";;
  lock)     res="${1:-status}"; [ $# -gt 0 ] && shift; [ "$res" != status ] || exec python3 "$tools/heavy_lock.py" status; exec python3 "$tools/heavy_lock.py" run --resource "$res" "$@";;
  status)   python3 "$tools/heavy_lock.py" status; exec python3 "$tools/ce_search.py" status;;
  docs)     exec python3 "$tools/ce_docs.py" "$@";;
  contract)
    case "${1:-}" in
      audit) shift; exec python3 "$tools/ce_interfaces.py" audit "$@";;
      robot-package) shift; exec python3 "$tools/ce_interfaces.py" robot-package "$@";;
      validate|list) exec python3 "$tools/ce_contract.py" "$@";;
      *) exec python3 "$tools/ce_contract.py" validate "$@";;
    esac;;
  report)   exec python3 "$tools/ce_report.py" "$@";;
  api)      exec python3 "$tools/ce_api.py" "$@";;
  sync)     exec python3 "$tools/ce_sync.py" --repo . "$@";;
  tidy)     exec python3 "$tools/ce_tidy.py" "$@";;
  plugins)  exec python3 "$tools/ce_plugins.py" "$@";;
  mail)     case "${1:-}" in ""|-*) exec python3 "$tools/ce_await_mail.py" "$@";; esac; exec python3 "$tools/ce_await_mail.py" --name "$@";;
  say|who)  exec python3 "$tools/ce_postfach.py" "$cmd" "$@";;
  help|--help|-h) sed -n 2,6p "$0";;
  *)        sed -n 2,6p "$0"; exit 2;;
esac
