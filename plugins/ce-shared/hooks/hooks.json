{
  "description": "ce-shared: gemeinsame Regeln (0.22: merge-nur-sightline auch für die GitHub-MCP-Merge-Werkzeuge) (rules/*.md), Subagent-Profile, Vor-Commit-Doku-Prüfung (warnt), SessionStart (Lehren, Sitzungsname, Werkzeugzeile) und Stop (ce_report, check-before-stop; warnt; 0.15: Postfach-Wächter startet von selbst, Erinnerung als Rückfall; 0.21: PostToolUse gibt neue Post mitten in der Arbeit als Hinweis in die Sitzung)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|mcp__github__merge_pull_request|mcp__github__enable_pr_auto_merge",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/precommit.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/postfach_watch.py\" watch",
            "async": true,
            "asyncRewake": true,
            "timeout": 43200
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/postfach_watch.py\" remind",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/postfach_inbox.py\" hint",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
