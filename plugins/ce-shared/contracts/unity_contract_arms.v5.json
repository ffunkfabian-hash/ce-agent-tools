{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ce://contracts/unity_contract_arms.v5",
  "title": "Toolgen shared ego arm package (format 5)",
  "description": "Structural validation of the existing Toolgen 0.19 export imported by Cube Escape 0.106; no producer format change. Semantic rig/clip validation remains in producer and consumer tests.",
  "type": "object",
  "required": [
    "format",
    "kind",
    "generator",
    "version",
    "asset",
    "model",
    "rig",
    "root",
    "nodes",
    "chains",
    "fingers",
    "materials",
    "renderers",
    "files",
    "units",
    "scale",
    "axes"
  ],
  "properties": {
    "format": {
      "type": "integer",
      "const": 5
    },
    "kind": {
      "const": "ego_arms"
    },
    "generator": {
      "const": "toolgen"
    },
    "rig": {
      "type": "object",
      "required": [
        "id",
        "version",
        "hash"
      ],
      "properties": {
        "id": {
          "const": "ego_arms"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "chains": {
      "type": "object",
      "required": [
        "R",
        "L"
      ],
      "properties": {
        "R": {
          "$ref": "#/$defs/names"
        },
        "L": {
          "$ref": "#/$defs/names"
        }
      }
    },
    "fingers": {
      "type": "object",
      "required": [
        "R",
        "L"
      ],
      "properties": {
        "R": {
          "$ref": "#/$defs/side"
        },
        "L": {
          "$ref": "#/$defs/side"
        }
      }
    },
    "renderers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/renderer"
      }
    },
    "materials": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/material"
      }
    },
    "files": {
      "type": "object",
      "required": [
        "fbx",
        "glb"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/file"
      }
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+( .*)?$"
    },
    "asset": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "const": "meter"
    },
    "scale": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "axes": {
      "type": "object",
      "required": [
        "blender",
        "unity",
        "fbx"
      ],
      "properties": {
        "blender": {
          "type": "object",
          "required": [
            "up",
            "forward"
          ],
          "properties": {
            "up": {
              "const": "+Z"
            },
            "forward": {
              "const": "-Y"
            }
          }
        },
        "unity": {
          "type": "object",
          "required": [
            "up",
            "forward"
          ],
          "properties": {
            "up": {
              "const": "+Y"
            },
            "forward": {
              "const": "+Z"
            }
          }
        },
        "fbx": {
          "type": "object",
          "required": [
            "axis_forward",
            "axis_up",
            "bake_space_transform"
          ],
          "properties": {
            "axis_forward": {
              "const": "-Z"
            },
            "axis_up": {
              "const": "Y"
            },
            "bake_space_transform": {
              "const": false
            }
          }
        }
      }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "quat": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "names": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "file": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "side": {
      "type": "object",
      "required": [
        "fingers",
        "thumb",
        "trigger_finger"
      ],
      "properties": {
        "fingers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/names"
          }
        },
        "thumb": {
          "$ref": "#/$defs/names"
        },
        "trigger_finger": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "name",
        "parent",
        "blender",
        "unity"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "blender": {
          "type": "object",
          "required": [
            "location",
            "rotation_wxyz",
            "scale"
          ],
          "properties": {
            "location": {
              "$ref": "#/$defs/vec3"
            },
            "rotation_wxyz": {
              "$ref": "#/$defs/quat"
            },
            "scale": {
              "$ref": "#/$defs/vec3"
            }
          }
        },
        "unity": {
          "type": "object",
          "required": [
            "localPosition",
            "localRotation",
            "localScale"
          ],
          "properties": {
            "localPosition": {
              "$ref": "#/$defs/vec3"
            },
            "localRotation": {
              "$ref": "#/$defs/quat"
            },
            "localScale": {
              "$ref": "#/$defs/vec3"
            }
          }
        }
      }
    },
    "material": {
      "type": "object",
      "required": [
        "color_srgb",
        "metallic",
        "roughness",
        "emission"
      ],
      "properties": {
        "color_srgb": {
          "$ref": "#/$defs/vec3"
        },
        "metallic": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "emission": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "renderer": {
      "type": "object",
      "required": [
        "name",
        "node",
        "parts",
        "materials",
        "triangles",
        "renderer"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "node": {
          "type": "string",
          "minLength": 1
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "materials": {
          "$ref": "#/$defs/names"
        },
        "triangles": {
          "type": "integer",
          "minimum": 0
        },
        "renderer": {
          "const": "MeshRenderer"
        }
      }
    }
  }
}
